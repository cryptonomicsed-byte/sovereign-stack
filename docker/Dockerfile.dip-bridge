# Build stage
FROM rust:1.82-slim AS builder
WORKDIR /build

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY sovereign-types/     sovereign-types/
COPY sovereign-runtime/   sovereign-runtime/
COPY ip-layer/            ip-layer/
COPY dip/                 dip/
COPY vcp/                 vcp/
COPY twin-protocol/       twin-protocol/
COPY arp-types/           arp-types/
COPY arp-broker/          arp-broker/
COPY ucx-protocol/        ucx-protocol/
COPY ucx-provider/        ucx-provider/
COPY ucx-broker/          ucx-broker/
COPY ucx-adapters/        ucx-adapters/
COPY swarm-types/         swarm-types/
COPY swarm-broker/        swarm-broker/
COPY witness-types/       witness-types/
COPY witness-broker/      witness-broker/
COPY sovereign-pipeline/  sovereign-pipeline/
COPY sovereign-a2a/       sovereign-a2a/
COPY sovereign-node/      sovereign-node/
COPY sovereign-cli/       sovereign-cli/
COPY sovereign-os/        sovereign-os/
COPY mycelium-finetune/   mycelium-finetune/

# dip is a library crate; sovereign-node exposes the /dip/* routes used by this bridge
RUN cargo build --release -p sovereign-node

# Runtime stage
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/sovereign-node /usr/local/bin/dip-bridge

# DIP bridge runs the sovereign-node in DIP-only mode via env
ENV DIP_PORT=7792
ENV DIP_MODE=bridge
ENV DIP_PEER_NODES=""
ENV VANTAGE_URL=""
ENV NODE_SECRET_KEY=""

EXPOSE 7792
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:7792/status || exit 1

CMD ["dip-bridge"]
